# Backend environment variables — DO NOT commit real values
# Copy this file to .env and fill in the values

# Your Google Gemini API Key (obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Gemini model name (e.g. gemini-2.0-flash, gemini-2.5-flash)
GEMINI_MODEL=

# Frontend URL for CORS (e.g. https://YOUR_GITHUB_USERNAME.github.io)
FRONTEND_URL=
